# --- Model (provider-neutral: change this line to switch models) ---------------------------------
# A plain id uses the OpenAI provider (reads OPENAI_API_KEY).  gpt-5.5 = strongest, gpt-5.4-mini = cheaper.
# An id with a slash ("anthropic/claude-sonnet-5-5", "google/gemini-...") goes through the Vercel AI Gateway (AI_GATEWAY_API_KEY).
LC_MODEL=gpt-5.5
# Model names: openai:gpt-5.5 | anthropic:claude-sonnet-5-5 | openrouter:google/gemini-3-pro | groq:openai/gpt-oss-120b | custom:<name>
# Keys can also be added in the app (Integrations -> AI models). A key here always wins.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Any OpenAI-compatible server (LM Studio, vLLM, Together ...)
LC_CUSTOM_BASE_URL=
LC_CUSTOM_API_KEY=

# --- Server -----------------------------------------------------------------------------------------
PORT=8790
HOST=127.0.0.1
# If set, every HTTP request must send:  Authorization: Bearer <LC_API_TOKEN>
LC_API_TOKEN=
LC_DATA_DIR=./data
LC_MAX_STEPS=30

# --- Hostinger (optional: theme file / CSS editing + read-only hosting info) ---------------------------
# Easiest: leave empty and paste the token in the app (sidebar -> Integrations). If set here, it always wins.
HOSTINGER_API_TOKEN=
# Browser for page checks + screenshots: Edge or Chrome is found automatically. Only set this if neither is installed.
# LC_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
