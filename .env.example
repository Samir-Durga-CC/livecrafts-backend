# Livecrafts backend settings.
# Copy this file to ".env" (cp .env.example .env) and fill in the values. ".env" is git-ignored - never commit or share it.
# Only ONE model key is required. Everything else is optional. Restart `npm start` after changing this file.

# --- Model (provider-neutral: change LC_MODEL to switch) ---------------------------------------------
# A plain id uses OpenAI (OPENAI_API_KEY).  gpt-5.5 = strongest, gpt-5.4-mini = cheaper.
# Prefixes: openai:gpt-5.5 | anthropic:claude-sonnet-5-5 | openrouter:google/gemini-3-pro | groq:openai/gpt-oss-120b | custom:<name>
LC_MODEL=gpt-5.5
# Keys can also be added in the app (Integrations -> AI models). A key here always wins.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Any OpenAI-compatible server (LM Studio, vLLM, Together ...), used with LC_MODEL=custom:<name>
LC_CUSTOM_BASE_URL=
LC_CUSTOM_API_KEY=

# --- Server -------------------------------------------------------------------------------------------
PORT=8790
HOST=127.0.0.1
# If set, every app/admin HTTP request must send:  Authorization: Bearer <LC_API_TOKEN>
# REQUIRED when the backend is reachable from anywhere other than your own computer.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LC_API_TOKEN=
# Where chats, connected sites, usage and logs are stored.
LC_DATA_DIR=./data
# Max tool steps per assistant run, and run / WordPress request timeouts (milliseconds).
LC_MAX_STEPS=30
# LC_JOB_TIMEOUT_MS=300000
# LC_BRIDGE_TIMEOUT_MS=30000

# --- Checks and safety ------------------------------------------------------------------------------
# 0 = do not check every change in a real browser (e.g. a server without Edge/Chrome). Default on.
# LC_VERIFY_CHANGES=1
# 1 = the assistant may edit theme files. They go LIVE at once (cannot be drafts). Default off.
# LC_ALLOW_THEME_FILES=0
# Browser for page checks + screenshots: Edge or Chrome is found automatically. Only set this if neither is installed.
# LC_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Voice mode (uses the OpenAI key above) ---------------------------------------------------------
# LC_TTS_VOICE=onyx
# LC_TTS_MODEL=gpt-4o-mini-tts
# LC_STT_MODEL=gpt-4o-mini-transcribe

# --- Hostinger (optional: theme file / CSS editing + read-only hosting info) ---------------------------
# Easiest: leave empty and paste the token in the app (sidebar -> Integrations). If set here, it always wins.
HOSTINGER_API_TOKEN=

# --- Extra assistant skills folder (default ./skills) -------------------------------------------------
# LC_SKILLS_DIR=./skills
